          }
        }
      }
    },
    "Show a small ↑ or ↓ next to a slot when its recent history shows a clear rise or fall. Hidden when steady — the menu bar doesn't flicker on sensor jitter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "当位置近期的历史数据显示明显上升或下降趋势时，在旁边显示小箭头 ↑ 或 ↓。平稳时隐藏——菜单栏不会因传感器波动而闪烁。"
          }
