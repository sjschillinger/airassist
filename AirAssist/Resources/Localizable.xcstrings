            "value": "无"
          }
        }
      }
    },
    "Note: closing the lid still sleeps the Mac unless an external display is connected — that's a macOS-level rule Stay Awake can't override.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
